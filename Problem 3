class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


def create_list(values):
    dummy = Node(0)
    current = dummy

    for value in values:
        current.next = Node(value)
        current = current.next

    return dummy.next


def add_lists(l1, l2):
    dummy = Node(0)
    current = dummy
    carry = 0

    while l1 or l2 or carry:
        x = l1.data if l1 else 0
        y = l2.data if l2 else 0

        total = x + y + carry

        current.next = Node(total % 10)
        carry = total // 10
        current = current.next

        if l1:
            l1 = l1.next

        if l2:
            l2 = l2.next

    return dummy.next


def print_list(head):
    result = []

    while head:
        result.append(head.data)
        head = head.next

    print(*result)


